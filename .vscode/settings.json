// VS Code와 Ruff를 연결하고 자동화
// VS Code에게 "Ruff를 언제 사용해"라고 알려주는 파일
{
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
        // Python 파일의 formatter는 Ruff로 사용하고, Ctrl + S로 저장할 때 자동으로 실행해
    },
    "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "explicit",
        "source.organizeImports.ruff": "explicit"
    },
    "editor.rulers": [88],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
    // 저장할 때 Ruff가 자동 수정 가능한 lint 문제 수정, import 정리, 88자 위치에 가이드라인 표시, 줄 끝 불필요한 공백 제거, 파일 마지막에 빈 줄(newline) 보장
}

// Ctrl + S
//    ↓
// VS Code가 파일 저장
//    ↓
// settings.json의 "formatOnSave": true 확인
//    ↓
// defaultFormatter로 지정된 Ruff 실행
//    ↓
// pyproject.toml의 Ruff 설정 적용
//    ↓
// 코드 자동 Formatting
